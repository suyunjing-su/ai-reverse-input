# Required: the New API base URL, without a path requirement.
NEW_API_BASE_URL=http://127.0.0.1:3000

# Listener
HOST=127.0.0.1
PORT=8787

# First-run admin bootstrap. Set both before starting for a fresh data directory.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
# Optional: persistent location for configuration and admin credential hash.
DATA_DIR=./data

# Limits and timeouts
REQUEST_TIMEOUT_MS=120000
MAX_REQUEST_BODY_BYTES=16777216
MAX_RESPONSE_BODY_BYTES=33554432
MAX_SSE_PREFLIGHT_BYTES=262144
MAX_SSE_PREFLIGHT_MS=10000
LOG_LEVEL=info

# Set true when the admin endpoint is served through HTTPS. Keep false only for local HTTP development.
COOKIE_SECURE=false

# Response/SSE safety limits
MAX_RESPONSE_BODY_BYTES=33554432
MAX_SSE_PREFLIGHT_BYTES=262144
MAX_SSE_PREFLIGHT_MS=10000
